# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Lab SIEM (Phase 1) ---
INDEXER_PASSWORD=changeme_strong_password
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme_strong_password

# --- Threat intel enrichment (Phase 2) -- all have free tiers ---
# None of these are required to run the assistant: without them it falls back
# to an offline/deterministic report (see README "Try it in 60 seconds").
VT_API_KEY=your_virustotal_api_key                 # https://www.virustotal.com/gui/join-us
ABUSEIPDB_API_KEY=your_abuseipdb_api_key           # https://www.abuseipdb.com/register
OTX_API_KEY=your_alienvault_otx_api_key            # https://otx.alienvault.com/api

# --- LLM for report synthesis (Phase 2) ---
# LLM_PROVIDER: "anthropic" (cloud) or "ollama" (local/offline, no key needed).
# Leave LLM_PROVIDER unset to use the offline deterministic report template.
LLM_PROVIDER=anthropic
LLM_API_KEY=your_anthropic_api_key                 # https://console.anthropic.com
LLM_MODEL=claude-sonnet-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Optional escalation webhook (Phase 2, Section 7.7) ---
ESCALATION_WEBHOOK_URL=
